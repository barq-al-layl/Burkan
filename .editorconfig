root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# The code is written to 120 columns, with a trailing comma on every list that spans lines. Android Studio's own
# defaults are 100 columns and no trailing commas, so a reformat without these would fight the code as it stands.
[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_line_break_after_multiline_when_entry = false
