<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The only sockets are to the phone itself: adbd on loopback or its own Wi-Fi address. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- mDNS, to find the ports wireless debugging advertises. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- From Android 17, mDNS discovery without it brings up the system's device picker instead of the ports. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Keeps the CPU awake for System UI's restart once the phone has locked, with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- The exclusions picker lists the installed apps; without it most are hidden from the app. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Granted to the app over its own adb connection during setup, to switch wireless debugging. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Allowed to the app over its own adb connection, the first time a run is limited to the most recent apps. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Not asked for by the app or by anything in it. The adb library's manifest names no SDK version, so the
         build takes it for one from before Android 1.6 and adds the permissions every app had then. -->
    <uses-permission
        android:name="android.permission.READ_PHONE_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />

    <application
        android:name=".BurkanApplication"
        android:allowBackup="true"
        android:appComponentFactory="io.github.barqallayl.burkan.core.di.BurkanAppComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Burkan"
        tools:replace="android:appComponentFactory">
        <!-- Hands the exported log file to the app the user shares it with. Nothing else is reachable through it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

        <!-- One copy of the screen, whoever starts it: a full apply brings the app back to the front from the
             shell, and a second copy on top of the first would have lost the run it was showing. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Burkan"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A long press on the Quick Settings tile opens the app. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- What the app's shortcuts open: it starts the run the shortcut names and closes, showing nothing. Its window
             is translucent and empty, as it finishes only once it has read the phone's state. Not exported: the
             launcher starts a shortcut in the app's own name. -->
        <activity
            android:name=".feature.apply.ShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Shown after a crash, in a process of its own: it starts when the app's has died, and needs nothing
             of the app to be in working order. -->
        <activity
            android:name=".feature.crash.ui.CrashActivity"
            android:exported="false"
            android:process=":crash"
            android:theme="@style/Theme.Burkan" />

        <service
            android:name=".feature.apply.ApplyService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps Burkan running while it restarts the phone's apps over its own adb connection, so the settings it changed are always put back." />
        </service>

        <!-- The Quick Settings tile. Only the system can bind it. -->
        <service
            android:name=".feature.apply.ApplyTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".feature.apply.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- How another app, Tasker for one, starts a run. Any app on the phone can send these, and each is acted
             on: the three runs are fixed, take no arguments, and never lock a phone that is in use. A permission
             of the app's own would not serve, since an automation app cannot be made to hold one. -->
        <receiver
            android:name=".feature.apply.TriggerReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="io.github.barqallayl.burkan.action.APPLY" />
                <action android:name="io.github.barqallayl.burkan.action.RESTART_OPEN_APPS" />
                <action android:name="io.github.barqallayl.burkan.action.RESTART_ALL" />
            </intent-filter>
        </receiver>

        <!-- Only the system's network callback reaches it, through the app's own PendingIntent. -->
        <receiver
            android:name=".feature.apply.NetworkReceiver"
            android:exported="false" />

        <service
            android:name=".feature.connection.PairingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Holds the notification the user types the wireless debugging pairing code into, because the system pairing dialog closes when the user leaves Settings." />
        </service>
    </application>

</manifest>
