    <string name="setup_connect_in_progress">Connecting…</string>
    <string name="setup_permission_title">Give Burkan its permission</string>
    <string name="setup_permission_text">Burkan grants itself the permission to switch wireless debugging, so it can work after a restart without you.</string>
    <string name="setup_battery_title">Let Burkan run after a restart</string>
    <string name="setup_battery_text">Without this, battery optimisation may stop Burkan from applying Vulkan when the phone starts.</string>
