<?xml version="1.0" encoding="utf-8"?>
<!--
    The ADB key and everything tied to this phone's pairing stay on this phone: restored elsewhere, they would claim a
    pairing that phone never made. Settings, which are not tied to the phone, are still backed up.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/device_state.preferences_pb" />
        <exclude domain="file" path="datastore/eu_anifantakis_ksafe_datastore_connection.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/device_state.preferences_pb" />
        <exclude domain="file" path="datastore/eu_anifantakis_ksafe_datastore_connection.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
